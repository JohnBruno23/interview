<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.doc</groupId>
	<artifactId>ChatDocsPOC-ora</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ChatDocsPOC-ora</name>
	<description>Demo project for Document AI </description>
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
		<connection />
		<developerConnection />
		<tag />
		<url />
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>


	<dependencies>

    <!-- Spring Boot Starter Web:
         Provides REST API development support, embedded Tomcat server,
         Spring MVC, JSON serialization/deserialization, and web-related features.
    -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Boot Starter Test:
         Includes JUnit, Mockito, AssertJ, Spring Test, and other testing
         libraries required for unit and integration testing.
    -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-test</artifactId>
        <scope>test</scope>
    </dependency>

    <!-- Spring Data JPA:
         Provides JPA and Hibernate support for database operations,
         repository pattern implementation, ORM mapping, and transaction management.
    -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Oracle JDBC Driver:
         Connects the Spring Boot application to Oracle Database.
         Required for executing SQL queries, transactions,
         and Oracle-specific features such as VECTOR datatype.
    -->
    <dependency>
        <groupId>com.oracle.database.jdbc</groupId>
        <artifactId>ojdbc11</artifactId>
        <version>23.5.0.24.07</version>
    </dependency>

    <!-- Google GenAI SDK:
         Official Google Gemini API client library.
         Used for generating embeddings, chatting with Gemini models,
         document question answering, and AI-powered features.
    -->
    <dependency>
        <groupId>com.google.genai</groupId>
        <artifactId>google-genai</artifactId>
        <version>1.6.0</version>
    </dependency>

    <!-- Apache PDFBox:
         Extracts text and metadata from PDF documents.
         Used for reading uploaded PDFs before generating embeddings
         and storing document content in the database.
    -->
    <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>3.0.3</version>
    </dependency>

    <!-- Lombok:
         Reduces boilerplate code by automatically generating
         getters, setters, constructors, builders, equals/hashCode,
         and logging utilities through annotations.
    -->
    <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
    </dependency>

    <!-- SpringDoc OpenAPI / Swagger:
         Automatically generates OpenAPI documentation and provides
         Swagger UI for testing and exploring REST APIs.
         URL: http://localhost:8080/swagger-ui.html
    -->
    <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>2.8.5</version>
    </dependency>

</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
